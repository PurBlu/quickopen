#!/bin/bash
# 双击这个文件即可完成安装：会自动打开「终端」，把开门服务交给 macOS 后台常驻。
# 只需要在第一次安装、或换过端口时双击一次；之后开机自动运行，无需再管。
cd "$(dirname "$0")" || exit 1
echo "正在安装「秒开门」后台服务…"
echo
./install.sh
echo
echo "----------------------------------------------------------"
echo "安装流程结束。这个终端窗口可以直接关掉，服务已在后台运行。"
echo "以后开机自动启动；查看状态请双击「查看状态.command」。"
echo "----------------------------------------------------------"
